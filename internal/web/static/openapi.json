  "components": {
    "schemas": {
      "StatusResponse": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "protocolVersion": {
            "type": "integer"
          },
          "backend": {
            "type": "string"
          },
          "agentInfo": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "permissionPolicy": {
            "type": "string"
          },
          "activeSessionCount": {
            "type": "integer"
          },
          "workspace": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "description": "Model family (agy configOptions id `model`)",
            "example": "gemini-4-carbon"
          },
          "thinkingLevel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "description": "agy configOptions id `thought_level`",
            "example": "medium"
          },
          "mode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "description": "agy configOptions id `mode`",
            "example": "default"
          }
        }
      },
      "Conversation": {
        "type": "object",
        "required": [
          "conversationId",
          "cwd",
          "live",
          "current"
        ],
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "cwd": {
            "type": "string",
            "description": "Absolute working directory"
          },
          "title": {
            "type": "string"
          },
          "live": {
            "type": "boolean",
            "description": "Open in this agyd's agy process"
          },
          "current": {
            "type": "boolean"
          },
          "model": {
            "type": "string",
            "description": "Live conversations only"
          },
          "thinkingLevel": {
            "type": "string",
            "description": "Live conversations only"
          },
          "mode": {
            "type": "string",
            "description": "Live conversations only"
          },
          "createTime": {
            "type": "string",
            "format": "date-time"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ListConversationsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Conversation"
            }
          }
        }
      },
      "CreateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "type": "string",
            "description": "Absolute path of an existing directory; defaults to the server workspace"
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "thinkingLevel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "mode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "use": {
            "type": "boolean",
            "default": true,
            "description": "Make the new conversation current"
          }
        }
      },
      "PromptRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string"
          }
        }
      },
      "PromptResult": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "thinkingLevel": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "stopReason": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CancelResponse": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "CANCEL_REQUESTED"
            ]
          }
        }
      },
      "ConfigValue": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfigValue"
            }
          },
          "thinkingLevels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfigValue"
            }
          },
          "modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfigValue"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
