{
  "openapi": "3.1.0",
  "info": {
    "title": "agyd",
    "version": "0.2.0",
    "description": "Local HTTP/SSE API wrapping agy-cli. Prompts go to the current conversation unless a conversation id is given. Every /healthz and /v1 response (errors included, Host-guard and CSRF 403s excepted) carries Agyd-Conversation, Agyd-Model, Agyd-Thinking-Level and Agyd-Mode. A known /healthz or /v1 path called with a method it does not support answers 405 METHOD_NOT_ALLOWED with an Allow header; an unknown path answers 404 NOT_FOUND."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "tags": [
          "service"
        ],
        "responses": {
          "204": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Get status",
        "tags": [
          "service"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
    "/v1/current": {
      "get": {
        "summary": "Get the current conversation",
        "tags": [
          "current"
        ],
        "description": "Resumes the current conversation if agy no longer has it live. 404 NO_CURRENT_CONVERSATION when none is set.",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      },
      "patch": {
        "summary": "Change the current conversation's settings",
        "tags": [
          "current"
        ],
        "description": "409 PROMPT_IN_FLIGHT while a turn runs. A value agy does not offer is 400 INVALID_SETTING. A value equal to the current one is not sent to agy.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
    "/v1/prompt": {
      "post": {
        "summary": "Prompt the current conversation",
        "tags": [
          "current"
        ],
        "description": "Creates a conversation with the defaults when none is current. The target is resolved once, when the request starts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptResult"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Sent when the request has `Accept: text/event-stream`. Events: session_update (raw ACP session update), prompt_done (PromptResult without updates), prompt_error (Error envelope)."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
    "/v1/cancel": {
      "post": {
        "summary": "Cancel the current conversation's turn",
        "tags": [
          "current"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
    "/v1/conversations": {
      "get": {
        "summary": "List conversations",
        "tags": [
          "conversations"
        ],
        "description": "Live conversations merged with agy's history (every agy conversation on the host), newest first. Settings are shown for live conversations only.",
        "parameters": [
          {
            "name": "cwd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Keep only conversations with this working directory"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListConversationsResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      },
      "post": {
        "summary": "Create a conversation",
        "tags": [
          "conversations"
        ],
        "description": "Starts from the defaults, then applies the given settings (a value agy rejects fails the request). Becomes current unless use is false.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Agyd-Conversation": {
                "$ref": "#/components/headers/AgydConversation"
              },
              "Agyd-Model": {
                "$ref": "#/components/headers/AgydModel"
              },
              "Agyd-Thinking-Level": {
                "$ref": "#/components/headers/AgydThinkingLevel"
              },
              "Agyd-Mode": {
                "$ref": "#/components/headers/AgydMode"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
